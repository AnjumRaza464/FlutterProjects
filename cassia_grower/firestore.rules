rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in company admin. Admin user ids are listed in the `admins`
    // collection; add them in the Firebase console (see lib/admin/ADMIN.md).
    // IMPORTANT: now that farmers and dealers also sign in, "any signed-in
    // user" is no longer the same as "an admin" — product/order writes must
    // check this, or a farmer could edit the catalog.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Catalog: anyone may read it (the farmer app is not signed in when it
    // browses); only admins may add / edit / remove products.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: the farmer app (not signed in) may only CREATE a new order,
    // with a sane shape. It can never read, change or delete orders.
    // Admins can read, update and delete them.
    match /orders/{id} {
      allow create: if request.resource.data.status == 'new'
                    && request.resource.data.customer is map
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 100;
      allow read, update, delete: if isAdmin();
    }

    // The admin / staff list. A signed-in user may read only their own entry
    // (to learn they are staff). Nobody writes it from the app — admin ids
    // are added by hand in the Firebase console.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Farmer accounts: each farmer may read and write only their own profile.
    // Admins may also read them (the admin panel's Farmers list), but never
    // write them — a profile is the farmer's own.
    match /farmers/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Dealer accounts: a dealer creates their own application (status must be
    // 'pending' with zero balances) and may read their own account, but can
    // never change their balance, tier or awards — only an admin can. This
    // keeps the ledger trustworthy.
    match /dealers/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.outstandingBalance == 0
                    && request.resource.data.totalPurchases == 0;
      allow update, delete: if isAdmin();
    }
  }
}
